# The ESP32 connects to this host over your LAN.
RLCD_HOST=0.0.0.0
RLCD_PORT=7777
RLCD_REFRESH_SEC=45

# Set a long random value whenever RLCD_HOST is not 127.0.0.1.
RLCD_AUTH_TOKEN=replace-with-a-random-token

# Defaults already point to Beijing; override these for another city.
RLCD_WEATHER_LAT=39.9042
RLCD_WEATHER_LON=116.4074
RLCD_WEATHER_CITY=BEIJING
RLCD_WEATHER_TTL=600
RLCD_RAIN_ALERT_PCT=30

# Optional GitHub workbench module. Use a read-only fine-grained token.
# GITHUB_TOKEN=github_pat_replace_me
# RLCD_GITHUB_REPOS=MaoYun98/codex-token-monitor-rlcd,owner/another-repo
# RLCD_GITHUB_TTL=300

# Optional. Defaults to ~/.codex.
# CODEX_HOME=C:\Users\your-name\.codex
